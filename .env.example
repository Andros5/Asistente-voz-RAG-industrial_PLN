# Weaviate local
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Coleccion de chunks en Weaviate
RAG_COLLECTION_NAME=Sinumerik808DChunks

# Documento parseado por LlamaParse/LlamaCloud
RAG_MARKDOWN_PATH=./data/manuals/808D_ADV_diagnostics_man_0718_en-US.md

# Chunking Strategy 2: por alarmas, subdividido por campos y longitud maxima
RAG_CHUNK_MAX_CHARS=2500
RAG_CHUNK_OVERLAP_CHARS=150

# Recuperacion
RAG_MODE=hybrid
RAG_TOP_K=5
RAG_HYBRID_CANDIDATES=25
RAG_RRF_K=60
RAG_MAX_CHARS_PER_CHUNK=1800

# Embeddings locales BGE para el candidato hibrido
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_MAX_SEQ_LENGTH=512
RAG_EMBEDDING_DEVICE=

# LLM local para T2 y T4 segun la PoC
LLM_MODEL_ID=mistralai/Ministral-3-8B-Instruct-2512
LLM_DTYPE=auto
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.0

# Cache persistente opcional de Hugging Face. Si no se define, se usa la cache por defecto del usuario.
# HF_HOME=C:/hf-cache-pln

# Parseo opcional con LlamaCloud
LLAMA_CLOUD_API_KEY=

# Generacion opcional del dataset de evaluacion con Groq
GROQ_API_KEY=
